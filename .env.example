# Chave secreta para a geração dos tokens JWT
JWT_SECRET=chave-secreta-jwt

#--------------------------------------
# Configuração do PostgreSQL
#--------------------------------------
ROOT_DB_USER=postgres
ROOT_DB_PASSWORD=senha_super_forte_do_postgres

#-----------------------------------
# Configuração da Aplicação
#-----------------------------------
API_DB_USER=seu_usuario_api
API_DB_PASSWORD=sua_senha_forte_api
DATABASE_HOST=financial_management_db
DATABASE_PORT=5432

#-----------------------------
# Configuração do Redis
#-----------------------------
REDIS_HOST=financial_management_redis
REDIS_PORT=6379
REDIS_PASSWORD=senha_redis

#-----------------------------------
# Configuração do Usuário Owner da Aplicação
#-----------------------------------
APPLICATION_OWNER_NAME=Admin Owner
APPLICATION_OWNER_EMAIL=owner@exemplo.com
# A senha abaixo deve ser um hash bcrypt gerado previamente
APPLICATION_OWNER_PASSWORD_HASH=$2a$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


